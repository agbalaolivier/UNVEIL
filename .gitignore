# ==========================================
# PROJET UNVEIL - Gitignore global
# ==========================================

# ==========================================
# Fichiers sensibles
# ==========================================
.env
.env.local
.env.*.local
.env.production.local
*.key
*.pem

# ==========================================
# Dependencies (Node.js)
# ==========================================
node_modules/
package-lock.json
yarn.lock

# ==========================================
# Build & Distribution
# ==========================================
dist/
build/
.next/
out/
*.tsbuildinfo

# ==========================================
# Backend spécifique
# ==========================================
backend/dist/
backend/build/
backend/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==========================================
# Frontend / Expo / React Native
# ==========================================
frontend/.expo/
frontend/web-build/
frontend/dist/
frontend/.metro-health-check*
frontend/app-example

# Native builds
frontend/ios/
frontend/android/

# ==========================================
# IDE & Editors
# ==========================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.sublime-workspace
.project
.classpath

# ==========================================
# Système d'exploitation
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
desktop.ini

# ==========================================
# Testing
# ==========================================
coverage/
.nyc_output/
*.lcov

# ==========================================
# Fichiers temporaires
# ==========================================
*.tmp
*.temp
.cache/

# ==========================================
# Outils de développement
# ==========================================
.vscode-test/
__pycache__/
*.pyo
