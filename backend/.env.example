# PostgreSQL (Supabase, Neon, Render, etc.)
DATABASE_URL=postgresql://user:password@host:5432/database

# Secret long et aléatoire pour signer les sessions JWT
JWT_SECRET=replace-with-a-long-random-secret

# Gemini
GEMINI_API_KEY=replace-with-your-gemini-key
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Runtime
NODE_ENV=development
PORT=5000

# Resend (envoi du code de réinitialisation de mot de passe par e-mail)
RESEND_API_KEY=
MAIL_FROM=UNVEIL <onboarding@resend.dev>
