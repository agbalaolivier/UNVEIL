{
  "expo": {
    "name": "UNVEIL",
    "slug": "unveil",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/waka-logo.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.wakascompany.unveil",
      "adaptiveIcon": {
        "backgroundColor": "#050B14",
        "foregroundImage": "./assets/images/waka-logo.png"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/waka-logo.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/waka-logo.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#050B14"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "300371c3-56eb-42ee-99f9-133e02b81f35"
      }
    }
  }
}